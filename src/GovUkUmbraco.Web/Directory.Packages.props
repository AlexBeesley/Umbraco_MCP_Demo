<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    <!--
      Default must match UmbracoAppLocalIcuVersion in GovUkUmbraco.Web.csproj. Defined here too because this file
      is imported before the main project's own PropertyGroup runs, so under CPM the PackageVersion below needs
      its own fallback to stay in sync with the RuntimeHostConfigurationOption value set from the same property.
    -->
    <UmbracoAppLocalIcuVersion Condition="'$(UmbracoAppLocalIcuVersion)' == ''">72.1.0.3</UmbracoAppLocalIcuVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Umbraco.Cms" Version="17.7.1" />
    <PackageVersion Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="17.7.1" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="$(UmbracoAppLocalIcuVersion)" />
    <!-- GOV.UK Design System for Umbraco (thepensionsregulator/govuk-frontend-aspnetcore-extensions).
         Brings in ThePensionsRegulator.GovUk.Frontend and GovUk.Frontend.AspNetCore transitively. -->
    <PackageVersion Include="ThePensionsRegulator.GovUk.Frontend.Umbraco" Version="10.1.7" />
    <PackageVersion Include="uSync" Version="17.4.3" />
    <!-- Registers the hosted MCP worker as a backoffice OAuth client (authorization code flow). -->
    <PackageVersion Include="Umbraco.Mcp.HostedAuth" Version="17.0.0-beta.3" />
  </ItemGroup>
</Project>
